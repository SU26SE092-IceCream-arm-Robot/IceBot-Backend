{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "IceBotApp"
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Jwt": {
      "Secret": "sadjklfgjasldfjoipji423olkjrewo8ifuasoidfjdsaft",
      "Issuer": "IceBotApp",
      "Audience": "IceBotUsers"
    }
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "From": "no-reply@example.com",
    "DisplayName": "Mail Support",
    "UserName": "smtp-user",
    "Password": "smtp-password",
    "EnableSsl": true,
    "OperationTimeoutSeconds": 30,
    "PasswordResetBaseUrl": "",
    "InvitationBaseUrl": ""
  },
  "Firebase": {
    "Enabled": true,
    "Resilience": {
      "OperationTimeoutSeconds": 10,
      "RetryCount": 1,
      "RetryDelayMilliseconds": 200,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerSamplingDurationSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 15
    },
    "PushDelivery": {
      "OperationTimeoutSeconds": 30
    }
  },
  "Payments": {
    "OrderPaymentWindow": {
      "DurationMinutes": 15
    },
    "SessionReconciliation": {
      "Enabled": true,
      "IntervalSeconds": 30,
      "StaleAfterSeconds": 30,
      "RetryDelaySeconds": 30,
      "BatchSize": 50
    }
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "BaseUrl": "https://api-merchant.payos.vn",
    "ReturnUrl": "",
    "CancelUrl": "",
    "ExpireMinutes": 15,
    "Resilience": {
      "AttemptTimeoutSeconds": 10,
      "TotalTimeoutSeconds": 20,
      "CircuitBreakerFailureRatio": 0.5,
      "CircuitBreakerMinimumThroughput": 10,
      "CircuitBreakerSamplingDurationSeconds": 30,
      "CircuitBreakerBreakDurationSeconds": 15
    }
  },
  "TimeZoneId": "SE Asia Standard Time",
  "ErrorHandling": {
    "ExposeStackTrace": false
  },
  "Observability": {
    "ServiceName": "IceBot.WebAPI",
    "Serilog": {
      "OtlpSinkEnabled": false
    },
    "OpenTelemetry": {
      "Enabled": true,
      "OtlpExporterEnabled": false,
      "OtlpEndpoint": "http://localhost:18889",
      "OtlpProtocol": "grpc",
      "Metrics": {
        "ExporterEnabled": false
      },
      "Tracing": {
        "ExporterEnabled": false
      }
    },
    "DebugBodyLogging": {
      "Enabled": false,
      "LogRequestBody": true,
      "LogResponseBody": false,
      "MaxBodyLength": 1000
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Diagnostics": {
    "ApiKey": "",
    "EnableExternalPing": false,
    "ExternalPingTimeoutSeconds": 5
  },
  "RobotArtifacts": {
    "ObjectStorage": {
      "Endpoint": "localhost:9000",
      "DownloadEndpoint": "localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "icebot-robot-artifacts",
      "UseSsl": false,
      "DownloadUseSsl": false,
      "AutoCreateBucket": false,
      "ReadRetryCount": 2,
      "ReadRetryDelayMilliseconds": 200,
      "DownloadUrlExpirySeconds": 900,
      "OrphanCleanupEnabled": true,
      "OrphanGracePeriodHours": 24,
      "OrphanCleanupIntervalHours": 24,
      "OrphanCleanupMaxDeletesPerRun": 100,
      "AuthoringImportRetentionHours": 168
    }
  },
  "DeploymentTimeoutReconciliation": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "MaxCommandsPerRun": 100,
    "AcceptedReportTimeoutMinutes": 30,
    "InstalledActivationTimeoutMinutes": 30
  },
  "OrderExecutionDispatch": {
    "Enabled": true,
    "CommandExpiryMinutes": 30,
    "MaxActiveCommandsPerEndpoint": 1,
    "ReconciliationIntervalSeconds": 10,
    "ReconciliationBatchSize": 50,
    "InitialDispatchSupportEscalationMinutes": 15,
    "TimeoutReconciliationIntervalSeconds": 30,
    "TimeoutReconciliationBatchSize": 100,
    "AcceptedReportTimeoutMinutes": 5,
    "RunningReportTimeoutMinutes": 30,
    "HeartbeatUnreachableMinutes": 2,
    "UnreachableSupportEscalationMinutes": 15,
    "MaxDispatchAttempts": 3
  },
  "ExecutionReportIngestion": {
    "MaxFutureClockSkewSeconds": 300
  },
  "EdgeTelemetryIngestion": {
    "MaxFutureClockSkewSeconds": 300,
    "HeartbeatTimeoutSeconds": 90,
    "ConnectivityReconciliationIntervalSeconds": 15,
    "ConnectivityReconciliationBatchSize": 100,
    "MaxBatchEventCount": 100,
    "AlertCorrelationWindowMinutes": 15
  },
  "DataRetention": {
    "Enabled": true,
    "IntervalHours": 24,
    "HeartbeatDays": 30,
    "DeviceEventDays": 90,
    "OperationLogDays": 90,
    "ProcessedSyncInboxDays": 180,
    "ExpiredIdentityCredentialDays": 30,
    "NotificationDeliveryDays": 90,
    "BatchSize": 1000,
    "MaxBatchesPerRun": 20
  },
  "InventoryAlertAutomation": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 100,
    "MaxBatchesPerRun": 20,
    "CreateMaintenanceTicketForEmpty": true
  },
  "NotificationDelivery": {
    "Enabled": true,
    "IntervalSeconds": 10,
    "BatchSize": 50,
    "ProcessingTimeoutSeconds": 120,
    "BaseRetryDelaySeconds": 30
  },
  "FulfillmentReminder": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 100
  },
  "DeploymentFailureNotification": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "BatchSize": 100
  },
  "EdgeCommandMqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "ClientId": "icebot-cloud-backend",
    "TopicPrefix": "icebot",
    "ConnectTimeoutSeconds": 5,
    "PublishTimeoutSeconds": 6,
    "PublishRetryCount": 1,
    "PublishRetryDelayMilliseconds": 250
  },
  "EdgeUplinkMqtt": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "TopicPrefix": "icebot",
    "ConsumerGroup": "icebot-cloud-uplink",
    "ConnectTimeoutSeconds": 5,
    "PublishTimeoutSeconds": 6,
    "ReconnectDelaySeconds": 5,
    "MaxPayloadBytes": 262144,
    "MaxConcurrentMessages": 16
  },
  "MqttCredentialProvisioning": {
    "Enabled": false,
    "Provider": "MosquittoDynamicSecurity",
    "Host": "localhost",
    "Port": 1883,
    "UseTls": false,
    "AdminUsername": "icebot-dynsec-admin",
    "SubscriberRole": "icebot-endpoint-subscriber",
    "TopicPrefix": "icebot",
    "TimeoutSeconds": 10,
    "RetryCount": 1,
    "RetryDelayMilliseconds": 500,
    "ReconciliationIntervalSeconds": 60,
    "ReconciliationBatchSize": 100
  },
  "LowCostControllerCapacity": {
    "MaxArtifactCount": 50,
    "MaxArtifactStorageBytes": 52428800
  },
  "ProductionInventoryReadiness": {
    "PublishPolicy": "Warn",
    "DeployPolicy": "Block"
  },
  "ProductionPackageUpgrade": {
    "Reconciliation": {
      "Enabled": true,
      "IntervalSeconds": 60,
      "MaterializingTimeoutMinutes": 15,
      "BatchSize": 100
    }
  },
  "ExecutionEndpointSecurity": {
    "SignedRequestMaxClockSkewSeconds": 300,
    "NonceRetentionSeconds": 900,
    "MaxRequestBodyBytes": 1048576
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IceBot_DB": "Host=localhost;Port=5432;Database=IceBotDB;Username=postgres;Password=p@ssw0rd12345"
  }
}
