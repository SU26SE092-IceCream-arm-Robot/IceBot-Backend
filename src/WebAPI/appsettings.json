{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "IceBotApp"
    }
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Jwt": {
      "Secret": "sadjklfgjasldfjoipji423olkjrewo8ifuasoidfjdsaft",
      "Issuer": "IceBotApp",
      "Audience": "IceBotUsers"
    }
  },
  "Email": {
    "Host": "smtp.example.com",
    "Port": 587,
    "From": "no-reply@example.com",
    "DisplayName": "Mail Support",
    "UserName": "smtp-user",
    "Password": "smtp-password",
    "EnableSsl": true,
    "PasswordResetBaseUrl": "",
    "InvitationBaseUrl": ""
  },
  "Firebase": {
    "Enabled": true
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "BaseUrl": "https://api-merchant.payos.vn",
    "ReturnUrl": "",
    "CancelUrl": "",
    "ExpireMinutes": 15
  },
  "TimeZoneId": "SE Asia Standard Time",
  "ErrorHandling": {
    "ExposeStackTrace": false
  },
  "Observability": {
    "ServiceName": "IceBot.WebAPI",
    "Serilog": {
      "OtlpSinkEnabled": false
    },
    "OpenTelemetry": {
      "Enabled": true,
      "OtlpExporterEnabled": false,
      "OtlpEndpoint": "http://localhost:18889",
      "OtlpProtocol": "grpc"
    },
    "DebugBodyLogging": {
      "Enabled": false,
      "LogRequestBody": true,
      "LogResponseBody": false,
      "MaxBodyLength": 1000
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Diagnostics": {
    "ApiKey": "",
    "EnableExternalPing": false,
    "ExternalPingTimeoutSeconds": 5
  },
  "RobotArtifacts": {
    "ObjectStorage": {
      "Endpoint": "localhost:9000",
      "DownloadEndpoint": "localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "icebot-robot-artifacts",
      "UseSsl": false,
      "DownloadUseSsl": false,
      "DownloadUrlExpirySeconds": 900,
      "OrphanCleanupEnabled": true,
      "OrphanGracePeriodHours": 24,
      "OrphanCleanupIntervalHours": 24,
      "OrphanCleanupMaxDeletesPerRun": 100
    }
  },
  "DeploymentTimeoutReconciliation": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "MaxCommandsPerRun": 100,
    "AcceptedReportTimeoutMinutes": 30,
    "InstalledActivationTimeoutMinutes": 30
  },
  "LowCostControllerCapacity": {
    "MaxArtifactCount": 50,
    "MaxArtifactStorageBytes": 52428800
  },
  "ExecutionEndpointSecurity": {
    "SignedRequestMaxClockSkewSeconds": 300,
    "NonceRetentionSeconds": 900,
    "MaxRequestBodyBytes": 1048576
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IceBot_DB": "Host=localhost;Port=5432;Database=IceBotDB;Username=postgres;Password=p@ssw0rd12345"
  }
}
