{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "IceBotApp"
    }
  },
  "Observability": {
    "Serilog": {
      "OtlpSinkEnabled": false
    },
    "OpenTelemetry": {
      "OtlpExporterEnabled": false
    },
    "DebugBodyLogging": {
      "Enabled": false
    }
  },
  "RobotArtifacts": {
    "ObjectStorage": {
      "Endpoint": "localhost:9000",
      "DownloadEndpoint": "localhost:9000",
      "AccessKey": "minioadmin",
      "SecretKey": "minioadmin",
      "BucketName": "icebot-robot-artifacts",
      "UseSsl": false,
      "DownloadUseSsl": false,
      "DownloadUrlExpirySeconds": 900,
      "OrphanCleanupEnabled": true,
      "OrphanGracePeriodHours": 24,
      "OrphanCleanupIntervalHours": 24,
      "OrphanCleanupMaxDeletesPerRun": 100
    }
  },
  "DeploymentTimeoutReconciliation": {
    "Enabled": true,
    "IntervalSeconds": 30,
    "MaxCommandsPerRun": 100,
    "AcceptedReportTimeoutMinutes": 30,
    "InstalledActivationTimeoutMinutes": 30
  },
  "LowCostControllerCapacity": {
    "MaxArtifactCount": 50,
    "MaxArtifactStorageBytes": 52428800
  },
  "ExecutionEndpointSecurity": {
    "SignedRequestMaxClockSkewSeconds": 300,
    "NonceRetentionSeconds": 900,
    "MaxRequestBodyBytes": 1048576
  }
}
